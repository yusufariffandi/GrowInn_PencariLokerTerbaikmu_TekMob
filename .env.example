# =========================================================
# GrowIn Flutter — Environment Variables
# Copy file ini menjadi ".env" lalu isi nilainya masing-masing.
# JANGAN commit file ".env" (sudah ada di .gitignore) ke git repo publik.
# =========================================================

# --- Supabase ---
# Ambil dari: Supabase Dashboard > Project Settings > API
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key

# --- Google Gemini AI ---
# Ambil dari: https://aistudio.google.com/app/apikey
# Dipakai untuk semua fitur AI: CV Generator, Interview Simulator, Cover Letter, Salary Insight
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.5-flash
